    {
      "id": "words",
      "kind": "normal",
      "requirement": "Match a whole string that is one or more words separated by exactly one space each, where a word is one or more lower case ASCII letters a to z. There must be no leading space, no trailing space, and never two spaces in a row. No character other than those letters and the single separating spaces may appear.",
      "reference": "\\A[a-z]+(?: [a-z]+)*\\Z",
      "naive_pattern": "^[a-z ]+$",
      "cases": [
