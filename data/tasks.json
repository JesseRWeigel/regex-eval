{
  "note": "Each task is a requirement plus a corpus of strings labelled match or no-match. The corpus is held out from the prompt. `reference` and `naive_pattern` are never used to grade a model; they exist so the unit suite can prove the labels are self consistent and that the adversarial cases actually have teeth. `naive` marks the cases an incurious test author would have written; the rest are the held-out traps.",
  "tasks": [
    {
      "id": "literal",
      "kind": "control_easy",
      "requirement": "Match a string that is exactly the three letters cat, with nothing before it and nothing after it.",
      "reference": "\\Acat\\Z",
      "naive_pattern": "cat",
      "cases": [
        {"s": "cat", "match": true, "trap": "plain", "naive": true},
        {"s": "dog", "match": false, "trap": "plain", "naive": true},
        {"s": "cats", "match": false, "trap": "anchor", "naive": false},
        {"s": "a cat", "match": false, "trap": "anchor", "naive": false},
        {"s": "cat ", "match": false, "trap": "anchor", "naive": false},
        {"s": "Cat", "match": false, "trap": "class-boundary", "naive": false},
        {"s": "", "match": false, "trap": "boundary", "naive": false},
        {"s": "ca", "match": false, "trap": "boundary", "naive": false}
      ]
    },
    {
      "id": "contradiction",
      "kind": "control_impossible",
      "requirement": "Match a string if and only if it contains the letter q. In addition, the string quick must not match, and no other exceptions apply.",
      "reference": null,
      "naive_pattern": null,
      "cases": [
        {"s": "quick", "match": true, "trap": "contradiction", "naive": true},
        {"s": "quick", "match": false, "trap": "contradiction", "naive": true},
        {"s": "queen", "match": true, "trap": "plain", "naive": true},
        {"s": "brown", "match": false, "trap": "plain", "naive": true}
      ]
    },
    {
      "id": "zip",
      "kind": "normal",
      "requirement": "Match a whole string that is a United States ZIP code: exactly five digits, optionally followed by a hyphen and exactly four more digits. The digits are the ASCII characters 0 to 9 only. Nothing else may appear in the string.",
      "reference": "\\A[0-9]{5}(?:-[0-9]{4})?\\Z",
      "naive_pattern": "\\d{5}(-\\d{4})?",
      "cases": [
        {"s": "12345", "match": true, "trap": "plain", "naive": true},
        {"s": "12345-6789", "match": true, "trap": "plain", "naive": true},
        {"s": "1234", "match": false, "trap": "length", "naive": true},
        {"s": "abcde", "match": false, "trap": "plain", "naive": true},
        {"s": "123456", "match": false, "trap": "length", "naive": false},
        {"s": "12345-678", "match": false, "trap": "length", "naive": false},
        {"s": "12345-67890", "match": false, "trap": "length", "naive": false},
        {"s": "12345-6789-0", "match": false, "trap": "length", "naive": false},
        {"s": "x12345", "match": false, "trap": "anchor", "naive": false},
        {"s": "12345x", "match": false, "trap": "anchor", "naive": false},
        {"s": " 12345", "match": false, "trap": "anchor", "naive": false},
        {"s": "12345 ", "match": false, "trap": "anchor", "naive": false},
        {"s": "12345-", "match": false, "trap": "boundary", "naive": false},
        {"s": "00000", "match": true, "trap": "boundary", "naive": false},
        {"s": "99999-0000", "match": true, "trap": "boundary", "naive": false},
        {"s": "١٢٣٤٥", "match": false, "trap": "unicode-digit", "naive": false}
      ]
    },
    {
      "id": "hexcolor",
      "kind": "normal",
      "requirement": "Match a whole string that is a CSS hex colour: a # character followed by exactly three or exactly six hexadecimal digits. Both upper and lower case letters a to f are allowed. Nothing else may appear in the string.",
      "reference": "\\A#(?:[0-9A-Fa-f]{3}|[0-9A-Fa-f]{6})\\Z",
      "naive_pattern": "#[0-9a-fA-F]{3,6}",
      "cases": [
        {"s": "#abc", "match": true, "trap": "plain", "naive": true},
        {"s": "#A1B2C3", "match": true, "trap": "plain", "naive": true},
        {"s": "#ghijkl", "match": false, "trap": "class-boundary", "naive": true},
        {"s": "abc", "match": false, "trap": "boundary", "naive": true},
        {"s": "#12345", "match": false, "trap": "length", "naive": false},
        {"s": "#ab", "match": false, "trap": "length", "naive": false},
        {"s": "#abcd", "match": false, "trap": "length", "naive": false},
        {"s": "#abcde", "match": false, "trap": "length", "naive": false},
        {"s": "#abcdef0", "match": false, "trap": "length", "naive": false},
        {"s": "##abc", "match": false, "trap": "anchor", "naive": false},
        {"s": "color: #abc", "match": false, "trap": "anchor", "naive": false},
        {"s": "#abc ", "match": false, "trap": "anchor", "naive": false},
        {"s": "#ABCDEF", "match": true, "trap": "boundary", "naive": false},
        {"s": "#000", "match": true, "trap": "boundary", "naive": false},
        {"s": "#GGG", "match": false, "trap": "class-boundary", "naive": false},
        {"s": "#0z0", "match": false, "trap": "class-boundary", "naive": false}
      ]
    },
    {
      "id": "time24",
      "kind": "normal",
      "requirement": "Match a whole string that is a time of day in 24 hour HH:MM form, with exactly two digits for the hour from 00 to 23, a colon, and exactly two digits for the minute from 00 to 59. Nothing else may appear in the string.",
      "reference": "\\A(?:[01][0-9]|2[0-3]):[0-5][0-9]\\Z",
      "naive_pattern": "[0-2][0-9]:[0-5][0-9]",
      "cases": [
        {"s": "12:34", "match": true, "trap": "plain", "naive": true},
        {"s": "00:00", "match": true, "trap": "boundary", "naive": true},
        {"s": "23:59", "match": true, "trap": "boundary", "naive": true},
        {"s": "7:05", "match": false, "trap": "length", "naive": true},
        {"s": "24:00", "match": false, "trap": "class-boundary", "naive": false},
        {"s": "23:60", "match": false, "trap": "class-boundary", "naive": false},
