    },
    {
      "id": "semver",
      "kind": "normal",
      "requirement": "Match a whole string that is a version of exactly three numeric parts separated by dots, for example 1.4.2. Each part is one or more ASCII digits and must not have a leading zero, though the single digit 0 is allowed. No prerelease or build suffix may be present and nothing else may appear in the string.",
      "reference": "\\A(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\Z",
      "naive_pattern": "^\\d+\\.\\d+\\.\\d+$",
      "cases": [
