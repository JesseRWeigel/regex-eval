        {"s": "\" \"", "match": true, "trap": "boundary", "naive": false},
        {"s": "\"tab\there\"", "match": true, "trap": "plain", "naive": false}
      ]
    },
    {
      "id": "identifier",
      "kind": "normal",
      "requirement": "Match a whole string that is an ASCII identifier: the first character is a letter a to z or A to Z or an underscore, and every later character is such a letter, an ASCII digit, or an underscore. Non ASCII letters are not allowed. As a special case the string class must not match.",
      "reference": "\\A(?!class\\Z)[A-Za-z_][A-Za-z0-9_]*\\Z",
      "naive_pattern": "^[A-Za-z_]\\w*$",
      "cases": [
        {"s": "foo", "match": true, "trap": "plain", "naive": true},
        {"s": "_x1", "match": true, "trap": "plain", "naive": true},
        {"s": "1x", "match": false, "trap": "boundary", "naive": true},
        {"s": "my var", "match": false, "trap": "plain", "naive": true},
        {"s": "class", "match": false, "trap": "negation", "naive": false},
        {"s": "classy", "match": true, "trap": "negation", "naive": false},
