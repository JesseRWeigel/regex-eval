        {"s": "1234", "match": false, "trap": "plain", "naive": false},
        {"s": "09:59", "match": true, "trap": "boundary", "naive": false},
        {"s": "20:00", "match": true, "trap": "boundary", "naive": false},
        {"s": "12-34", "match": false, "trap": "plain", "naive": false}
      ]
    },
    {
      "id": "quoted",
      "kind": "normal",
      "requirement": "Match a whole string that consists of exactly one double quoted segment: one double quote character, then zero or more characters that are not double quotes, then one closing double quote. Nothing may appear before the opening quote or after the closing quote.",
      "reference": "\\A\"[^\"]*\"\\Z",
      "naive_pattern": "\".*\"",
      "cases": [
        {"s": "\"hello\"", "match": true, "trap": "plain", "naive": true},
        {"s": "\"multi word here\"", "match": true, "trap": "plain", "naive": true},
        {"s": "\"\"", "match": true, "trap": "boundary", "naive": true},
        {"s": "hello", "match": false, "trap": "plain", "naive": true},
        {"s": "\"a\" and \"b\"", "match": false, "trap": "greedy", "naive": false},
        {"s": "\"a\"  \"b\"", "match": false, "trap": "greedy", "naive": false},
        {"s": "\"say \"\"hi\"\"\"", "match": false, "trap": "greedy", "naive": false},
        {"s": "\"\"\"\"", "match": false, "trap": "greedy", "naive": false},
        {"s": "\"unclosed", "match": false, "trap": "boundary", "naive": false},
        {"s": "unopened\"", "match": false, "trap": "boundary", "naive": false},
